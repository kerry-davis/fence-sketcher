{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fence-sketcher-share",
  "main": "share-worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-share",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SHARES",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
